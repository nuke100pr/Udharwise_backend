RAILS_ENV=production

# Strong secrets — generate on your laptop:
#   openssl rand -hex 64   → SECRET_KEY_BASE
#   openssl rand -hex 32   → JWT_SECRET / POSTGRES_PASSWORD
SECRET_KEY_BASE=
JWT_SECRET=
POSTGRES_USER=udharwise
POSTGRES_PASSWORD=
POSTGRES_DB=udharwise

# Public hostname for this API (DNS A record → EC2 public IP)
API_DOMAIN=api.yourdomain.com
RAILS_ALLOWED_HOSTS=api.yourdomain.com

# Set after the Vercel URL exists
FRONTEND_ORIGINS=https://your-app.vercel.app

# Password auth works with async (no Sidekiq). OTP email later: set sidekiq + SMTP.
ACTIVE_JOB_ADAPTER=async
REDIS_URL=redis://redis:6379/0
